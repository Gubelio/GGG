political_decisions = {

    player_settings_open = {
        alert = yes
        potential = {
			NOT = { year = 1309 }            
			ai = no
			NOT = { has_country_flag = player_settings_opened }
        }

        allow = {
        }

        effect = {
			set_country_flag = player_settings_opened
			clr_country_flag = player_settings_closed
        }
		
    }

    player_settings_close = {
        alert = no
        potential = {
			NOT = { year = 1309 }
			ai = no
			has_country_flag = player_settings_opened
        }

        allow = {
        }

        effect = {
			set_country_flag = player_settings_closed
			clr_country_flag = player_settings_opened
        }
		
    }


    bankruptcy_events = {
        alert = no
        potential = {
			NOT = { year = 1309 }
			ai = no
			has_country_flag = player_settings_opened
			NOT = { has_country_flag = bankruptcy_events_disabled }
        }

        allow = {
        }

        effect = {
			set_country_flag = bankruptcy_events_disabled
        }
		
    }
	
    enable_multiplayer = {
        alert = no
        potential = {
			NOT = { year = 1309 }
			ai = no
			has_country_flag = player_settings_opened
			NOT = { has_country_flag = multiplayer_enabled }
        }

        allow = {
        }

        effect = {
			set_country_flag = multiplayer_disabled
        }
		
    }
	
    not_interested_in_grants = {
        alert = no
        potential = {
			ai = no
			has_country_flag = multiplayer_enabled
			NOT = { has_country_flag = not_interested_in_grants }
        }

        allow = {
        }

        effect = {
			set_country_flag = not_interested_in_grants
			clr_country_flag = interested_in_grants
        }
    }

    interested_in_grants = {
        alert = no
        potential = {
			ai = no
			has_country_flag = multiplayer_enabled
			has_country_flag = not_interested_in_grants
        }

        allow = {
        }

        effect = {
			set_country_flag = interested_in_grants
			clr_country_flag = not_interested_in_grants
        }
    }

    request_grant = {
        alert = no
        potential = {
			ai = no
			has_country_flag = multiplayer_enabled
			NOT = { has_country_flag = not_interested_in_grants }
        }

        allow = {
        }

        effect = {

			any_country = {
				limit = {
					ai = no
					OR = { 
						NOT = { has_country_flag = multiplayer_disabled }
						NOT = { has_country_flag = not_interested_in_grants }
					}
				}
				country_event = { id = 50016 }
			}
        }
    }
	
	
}	